{
    "name": "slothsoft/minecraft",
    "description": "A Farah module containing the Minecraft section of slothsoft.net.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=7.4",
        "slothsoft/chat": "^1.1.4",
        "slothsoft/core": "^1.15.0",
        "slothsoft/farah": "^1.27.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Minecraft\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Minecraft\\": "tests/"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-minecraft/",
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
